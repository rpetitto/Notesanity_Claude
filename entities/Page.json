{
  "name": "Page",
  "type": "object",
  "properties": {
    "binderId": { "type": "string" },
    "sectionId": { "type": "string" },
    "folderId": { "type": "string", "description": "Optional folder this page belongs to" },
    "title": { "type": "string" },
    "orderIndex": { "type": "number", "default": 0 },
    "pageType": { "type": "string", "enum": ["DRIVE_FILE", "CANVAS", "UPLOAD", "EMBED"], "default": "DRIVE_FILE" },
    "originType": { "type": "string", "enum": ["TEACHER_DISTRIBUTED", "STUDENT_ADDED", "DRIVE_DISCOVERED", "CLASSROOM_SYNC"], "default": "STUDENT_ADDED" },
    "distributionType": { "type": "string", "enum": ["REFERENCE", "TEMPLATE_COPY", "NONE"], "default": "NONE" },
    "distributionStatus": { "type": "string", "enum": ["private", "viewOnlyDistributed", "copyDistributed"], "default": "private", "description": "Distribution status of the page" },
    "moveScope": { "type": "string", "enum": ["WITHIN_SECTION_ONLY", "FULL"], "default": "FULL" },
    "ownerUserId": { "type": "string" },
    "origin": { "type": "string", "enum": ["APP", "DRIVE", "CLASSROOM"], "default": "APP" },
    "managedByApp": { "type": "boolean", "default": true },
    "pageSourceId": { "type": "string" },
    "driveFileId": { "type": "string" },
    "driveMimeType": { "type": "string" },
    "thumbnailUrl": { "type": "string" },
    "canvasDocId": { "type": "string" },
    "deletedAt": { "type": "string", "format": "date-time" },
    "deletedByUserId": { "type": "string" }
  },
  "required": ["binderId", "sectionId", "title"]
}
