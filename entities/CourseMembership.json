{
  "name": "CourseMembership",
  "type": "object",
  "properties": {
    "courseId": { "type": "string", "description": "Course ID" },
    "userId": { "type": "string", "description": "User ID" },
    "roleInCourse": { "type": "string", "enum": ["STUDENT", "TEACHER", "CO_TEACHER"], "description": "Role in this specific course" },
    "googleClassroomUserId": { "type": "string" },
    "status": { "type": "string", "enum": ["active", "invited", "removed"], "default": "active" }
  },
  "required": ["courseId", "userId", "roleInCourse"]
}
