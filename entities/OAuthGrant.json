{
  "name": "OAuthGrant",
  "type": "object",
  "properties": {
    "userId": { "type": "string", "description": "User ID who granted OAuth" },
    "provider": { "type": "string", "enum": ["GOOGLE"], "default": "GOOGLE" },
    "accessToken": { "type": "string", "description": "Encrypted access token" },
    "refreshToken": { "type": "string", "description": "Encrypted refresh token" },
    "scopes": { "type": "array", "items": { "type": "string" }, "description": "Granted OAuth scopes" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "revokedAt": { "type": "string", "format": "date-time" }
  },
  "required": ["userId", "provider"]
}
