{
  "name": "Folder",
  "type": "object",
  "properties": {
    "binderId": { "type": "string" },
    "sectionId": { "type": "string" },
    "parentFolderId": { "type": "string", "description": "For nested folders" },
    "title": { "type": "string" },
    "orderIndex": { "type": "number", "default": 0 },
    "driveFolderId": { "type": "string", "description": "Google Drive folder ID" },
    "ownerUserId": { "type": "string" },
    "origin": { "type": "string", "enum": ["APP", "DRIVE", "CLASSROOM"], "default": "APP" },
    "deletedAt": { "type": "string", "format": "date-time" }
  },
  "required": ["binderId", "sectionId", "title"]
}
