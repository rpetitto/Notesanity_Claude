{
  // Notesanity on Cloudflare, owned outright rather than through a platform.
  //
  // `nodejs_compat` is required: the request-scoping seam uses AsyncLocalStorage
  // so that two districts' requests in one isolate can never share a database
  // handle.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notesanity",
  "main": "src/worker/entry.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true
  },

  // The application still imports the vendor's module names. Pointing them at
  // our own platform means the migration touches no application code, and the
  // two stacks stay comparable while the move is verified. The imports get
  // rewritten to their real names at cutover, once there's nothing to compare.
  "alias": {
    "flingit": "./src/worker/platform/index.ts",
    "flingit/plugin/email-send": "./src/worker/platform/email.ts"
  },

  // The built SPA is served straight from the edge; only /api/* reaches the
  // Worker, so page loads cost no Worker invocation.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notesanity",
      "database_id": "e41a3e56-4ae1-4e54-ad2f-1e76ee95500c"
    }
  ],

  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "notesanity-assets"
    }
  ],

  // Matches the schedule the mail-queue drain registers in src/worker/index.ts.
  "triggers": {
    "crons": ["* * * * *"]
  }
}
